{
  "name": "web-knowledge-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:install": "playwright install chromium --no-shell",
    "test:e2e": "wxt build --mode test && playwright test",
    "audit:manifest": "node scripts/audit-manifest.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run audit:manifest"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "29.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wxt": "0.21.4"
  }
}
